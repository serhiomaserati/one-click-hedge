# ─────────────────────────────────────────────────────────────
# Polymarket One-Click Hedge — environment template
# Copy this file to ".env.local" and fill in the values.
# ".env.local" is gitignored — secrets NEVER get committed.
# ─────────────────────────────────────────────────────────────

# CLOB API endpoint (V2). Leave as default unless Polymarket changes it.
CLOB_HOST=https://clob.polymarket.com

# Your builder code (bytes32, public attribution identifier — goes into orders).
# This is NOT a secret; it's how fees get attributed to you.
BUILDER_CODE=

# Builder fee in basis points charged on orders (15 = 0.15%). Max 100 (1%).
BUILDER_FEE_BPS=15

# Builder API address (public, from the builder profile — "only for API use").
BUILDER_API_ADDRESS=

# ── SECRETS BELOW — keep these private, never share ──

# Builder API credentials (L2) used to sign builder headers for fee collection.
# Get these from your Polymarket builder profile.
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# Anthropic API key — powers the AI risk advisor (Claude).
# Get one at https://console.anthropic.com. Without it, the AI panel is hidden.
ANTHROPIC_API_KEY=

# The wallet private key that signs orders (the trader's key).
# In the final app this comes from the user's connected wallet in the browser —
# this server-side var is only for local testing / scripts. NEVER commit it.
WALLET_PRIVATE_KEY=
