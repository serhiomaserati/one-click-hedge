# ─────────────────────────────────────────────────────────────
# Polymarket One-Click Hedge — environment template
# Copy this file to ".env.local" and fill in the values.
# ".env.local" is gitignored — secrets NEVER get committed.
# ─────────────────────────────────────────────────────────────

# CLOB API endpoint (V2). Leave as default unless Polymarket changes it.
CLOB_HOST=https://clob.polymarket.com

# Privy App ID (public — email + wallet login). From dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=

# Your builder code (bytes32, PUBLIC attribution id — goes directly into each
# order's `builder` field on CLOB V2). NOT a secret. The browser needs it, so it
# must be NEXT_PUBLIC_. The app also has a hardcoded fallback, so prod works
# even if this is unset.
NEXT_PUBLIC_BUILDER_CODE=
# Server-side copy (optional; used by server reads/health only).
BUILDER_CODE=

# Builder fee is configured in your Polymarket builder profile (taker bps), NOT
# in the order on V2. Kept for reference only.
BUILDER_FEE_BPS=15

# ── LEGACY (CLOB V1) — no longer used for orders on V2 ──
# V2 builder attribution is native (builderCode in the order); the old HMAC
# header flow + builder-signing-sdk are gone. These are only needed if you later
# add the gasless Relayer. Safe to leave blank.
BUILDER_API_ADDRESS=
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# Anthropic API key — powers the AI risk advisor (Claude).
# Get one at https://console.anthropic.com. Without it, the AI panel is hidden.
ANTHROPIC_API_KEY=

# The wallet private key that signs orders (the trader's key).
# In the final app this comes from the user's connected wallet in the browser —
# this server-side var is only for local testing / scripts. NEVER commit it.
WALLET_PRIVATE_KEY=
